{
  "name": "web-clash-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "assets": "node scripts/fetch-assets.mjs",
    "test:offline": "node scripts/check-offline.mjs",
    "assets:sprites": "node scripts/import-sprites.mjs",
    "assets:scenery": "node scripts/compose-scene.mjs",
    "assets:combat": "node scripts/import-combat.mjs",
    "assets:effects": "node scripts/import-effects.mjs",
    "assets:destruction": "node scripts/import-destruction.mjs && npm run assets:effects",
    "assets:buildings": "node scripts/import-buildings.mjs",
    "assets:ui": "node scripts/import-ui.mjs",
    "assets:intro": "node scripts/import-intro.mjs",
    "assets:elixir": "node scripts/import-elixir.mjs",
    "assets:cards": "node scripts/import-cards.mjs",
    "assets:health": "node scripts/import-health.mjs",
    "assets:hud": "node scripts/import-hud.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.2.6",
    "@fontsource/nunito-sans": "^5.2.5",
    "lucide": "^0.468.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
