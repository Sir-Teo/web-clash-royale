{
  "name": "web-clash-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "assets": "node scripts/fetch-assets.mjs",
    "test:offline": "node scripts/check-offline.mjs",
    "assets:sprites": "node scripts/import-sprites.mjs",
    "assets:scenery": "node scripts/compose-scene.mjs",
    "assets:combat": "node scripts/import-combat.mjs",
    "assets:effects": "node scripts/import-effects.mjs",
    "assets:destruction": "node scripts/import-destruction.mjs && npm run assets:effects",
    "assets:buildings": "node scripts/import-buildings.mjs",
    "assets:ui": "node scripts/import-ui.mjs",
    "assets:intro": "node scripts/import-intro.mjs",
    "assets:elixir": "node scripts/import-elixir.mjs",
    "assets:cards": "node scripts/import-cards.mjs",
    "assets:health": "node scripts/import-health.mjs",
    "assets:hud": "node scripts/import-hud.mjs",
    "assets:connection": "node scripts/import-hud.mjs --connection",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "vite preview --host 0.0.0.0",
    "dev:legacy": "VITE_LEGACY_ROOMS=1 vite --host 0.0.0.0",
    "build:legacy": "VITE_LEGACY_ROOMS=1 npm run build && npm run build:server",
    "start:legacy": "node dist-server/index.js",
    "assets:ending": "node scripts/import-ending.mjs",
    "assets:emotes": "node scripts/import-emotes.mjs",
    "assets:death-audio": "node scripts/import-death-audio.mjs",
    "assets:combat-audio": "node scripts/import-combat-audio.mjs",
    "assets:screen-shake": "node scripts/import-screen-shake.mjs",
    "assets:charge-marker": "node scripts/import-charge-marker.mjs",
    "assets:charge-filter": "node scripts/import-charge-filter.mjs",
    "assets:deploy-filter": "node scripts/import-deploy-filter.mjs",
    "assets:freeze": "node scripts/import-freeze.mjs",
    "assets:poison": "node scripts/import-poison.mjs",
    "assets:rage": "node scripts/import-rage.mjs",
    "assets:rage-filter": "node scripts/import-rage-filter.mjs",
    "assets:rocket": "node scripts/import-rocket.mjs",
    "assets:lightning": "node scripts/import-lightning.mjs",
    "assets:log": "node scripts/import-log.mjs",
    "assets:tornado": "node scripts/import-tornado.mjs",
    "assets:goblin-barrel": "node scripts/import-goblin-barrel.mjs",
    "assets:graveyard": "node scripts/import-graveyard.mjs",
    "assets:clone": "node scripts/import-clone.mjs",
    "assets:mirror": "node scripts/import-mirror.mjs",
    "assets:swarm-cards": "node scripts/import-swarm-cards.mjs",
    "assets:goblin-gang": "node scripts/import-goblin-gang.mjs",
    "assets:barbarians": "node scripts/import-barbarians.mjs",
    "assets:royal-giant": "node scripts/import-royal-giant.mjs",
    "assets:mega-minion": "node scripts/import-mega-minion.mjs",
    "assets:dart-goblin": "node scripts/import-dart-goblin.mjs",
    "assets:ice-wizard": "node scripts/import-ice-wizard.mjs",
    "assets:clone-filter": "node scripts/import-clone-filter.mjs",
    "assets:poison-filter": "node scripts/import-poison-filter.mjs",
    "assets:cold-filter": "node scripts/import-cold-filter.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.2.6",
    "@fontsource/nunito-sans": "^5.2.5",
    "lucide": "^0.468.0",
    "sirv": "^3.0.2",
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
